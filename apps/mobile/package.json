{
  "name": "@xlt/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "ANDROID_HOME=${ANDROID_HOME:-/opt/android-sdk} ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-/opt/android-sdk} PATH=${ANDROID_HOME:-/opt/android-sdk}/platform-tools:${PATH} react-native run-android",
    "start": "react-native start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run build:android:debug",
    "lint": "echo mobile lint placeholder",
    "build:android:debug": "cd android && ANDROID_HOME=${ANDROID_HOME:-/opt/android-sdk} ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-/opt/android-sdk} PATH=${ANDROID_HOME:-/opt/android-sdk}/platform-tools:${PATH} ./gradlew assembleDebug",
    "clean:android": "cd android && ./gradlew clean",
    "start:reset-cache": "react-native start --reset-cache",
    "build:android:standalone": "cd android && ANDROID_HOME=${ANDROID_HOME:-/opt/android-sdk} ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-/opt/android-sdk} PATH=${ANDROID_HOME:-/opt/android-sdk}/platform-tools:${PATH} ./gradlew assembleStandalone"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@xlt/shared": "workspace:*",
    "react": "18.3.1",
    "react-native": "0.75.4"
  },
  "devDependencies": {
    "@react-native-community/cli": "^15.0.1",
    "@react-native-community/cli-platform-android": "^15.0.1",
    "@react-native/gradle-plugin": "0.75.4",
    "@react-native/metro-config": "0.75.4",
    "@types/react": "^18.3.11",
    "typescript": "^5.6.3"
  }
}
