# App / API
NODE_ENV=development
API_PORT=3000
WEB_ADMIN_PORT=3001
API_BASE_URL=http://api.lnize.top:8080
WEB_ADMIN_URL=http://admin.lnize.top:8080
NEXT_PUBLIC_API_BASE_URL=http://api.lnize.top:8080
MOBILE_API_BASE_URL=http://api.lnize.top:8080

# Database
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=delivery_db
POSTGRES_USER=delivery_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://delivery_user:change_me@127.0.0.1:5432/delivery_db

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

# First run setup
FIRST_RUN_SETUP_ENABLED=true
ADMIN_PASSWORD_SETUP_MODE=first_run
COST_PRICE_PASSWORD_SETUP_MODE=first_run
STORE_PASSWORD_AS_HASH_ONLY=true

# FRP
FRP_SERVER_ADDR=42.121.105.101
FRP_SERVER_PORT=7000
FRP_TOKEN=change_me
FRP_HTTP_VHOST_PORT=8080

# AMap
AMAP_ANDROID_KEY=change_me
AMAP_WEB_KEY=change_me

# Android
ANDROID_PACKAGE_NAME=com.xlt.delivery
APP_NAME=小灵通

# Print
ENABLE_BLUETOOTH_PRINT=true
DEFAULT_PRINTER_PAPER_SIZE=58mm
